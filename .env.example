# Orchestra runs entirely on subscription OAuth — ANTHROPIC_API_KEY must stay UNSET.
# (If set, claude -p silently bills the API instead of the subscription.)
#
# Every setting here is OPTIONAL: each has a working default, resolved in
# src/orchestra/config.py (and mirrored for the shell scripts in
# scripts/config.sh). Nothing loads this file automatically — copy it to .env
# as a record of your choices, then source it from your shell profile.
#
# Values shown are the defaults.

# Root directory for the agent blackboard: per-agent status.json, inbox.md,
# task.md, agent.log, plus the agents' git worktrees.
ORCHESTRA_AGENTS_DIR=$HOME/orchestra-agents

# tmux session holding one window per agent.
ORCHESTRA_TMUX_SESSION=orchestra

# Name a process reports as when it messages another agent.
ORCHESTRA_AGENT_NAME=peer

# Command the watchdog invokes as "<cmd> lead <reason>".
ORCHESTRA_NUDGE_CMD=scripts/agent_msg.py

# Observability endpoint. Set to the EMPTY string to disable emission entirely.
ORCHESTRA_EVENTS_URL=http://localhost:4000/events

# Observability dashboard ports. Unprefixed on purpose: scripts/up.py passes
# them through to the upstream observability repo's start-system.sh, which
# reads these exact names.
SERVER_PORT=4000
CLIENT_PORT=5173

# ORCHESTRA_NOTIFY_TARGET is set automatically by spawn_agent for each worker
# and is not something you configure here.
